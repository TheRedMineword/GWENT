# Also put .env where server.js is, its placed here so it dont spam main directory
# Also I dont think any body will read this file

STREAM_DEBUG=true                   # (optional) "false" silences SSE/stream logs (default: true)
SOCKET_DEBUG=false                  # (optional) "true" = verbose [socket] logs
deep_log_coin=                      # (optional) any non-empty value enables coin roll/chance logs
VERIF=                              # (optional) only printed to the console at startup

# ---- Updater (updater.js) ---------------------------------------------------
# NOTE: code compares with ===1 against a string, so env values never match 1
# and it always uses the localhost URL. Left here for reference.
updatermode=1

# ---- Admin / auth -----------------------------------------------------------
ADMIN_ENDPOINT_LOGIN=change-me-long-random-string   # key for admin endpoints (?key=...)
A=/some/secret/route                                # path for the router.get(process.env.A) route - REQUIRED, must start with "/"
AUTH_HEX=change-me-random-hex-salt                  # salt used by encryptPassword()
SECRET_ADDON=                                       # base64-encoded code blob loaded at runtime

# ---- Database (Xano) --------------------------------------------------------
XANO_URL=https://xxxx-xxxx-xxxx.n7.xano.io/api:abcdEFGH
DB_ID=1

# ---- Remote config URLs (optional) ------------------------------------------
# Must end with a trailing slash
GWENT_URL_COIN=https://theredmineword.github.io/GWENT/
GWENT_URL_COIN2=https://drmineword-gwent.onrender.com/

# ---- WebSocket --------------------------------------------------------------
WS_VERSION=1                        # (optional) server socket version, used if trafficMonitor doesn't override it

# ---- Bug reports ------------------------------------------------------------
BUG_REPORT_QUEUE_API=https://example.com/api/bug-queue
BUG_REPORT_QUEUE_KEY=change-me
BR_MAX_BODY=50mb                    # (optional) default: no limit
BR_MAX_IMAGE_MB=10                  # (optional) default: no limit

# ---- Patch notes (GitHub) ---------------------------------------------------
PATCHES_GIT=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx     # GitHub token, sent as "Bearer <token>"

# ---- Log forwarding to Discord (optional) -----------------------------------
# Must be valid JSON on ONE line. Enabled only if use=true AND put_api is set.
forward_logs={"use":false,"put_api":"https://discord.com/api/webhooks/ID/TOKEN","maxatonce":50,"limitsbeetwencalls":7}

# ---- Discord bot integration (dcapi.js) -------------------------------------
dc_bot_integration_use=false        # "true" loads dcapi.js; anything else disables it
dc_api_free_money_on_solo_loss=true # (optional) "false" disables free money on solo loss (default: true)

# ---- Discord verification (dcverify.js) -------------------------------------
DCVERIFY_IP_SALT=change-me-random-salt  # (optional) salt for the IP sha256
DCVERIFY_STRICT_IP=1                    # (optional) "0" lets the IP change during a session
DCVERIFY_QUESTIONS=3                    # (optional) questions per run
DCVERIFY_DEBUG=0                        # (optional) "1" = debug logs (also logs answers)
